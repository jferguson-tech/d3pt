#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Glow around what is brighter than the screen can show. Works on a half
// size copy: the bright part is taken out, blurred widely, and added back
// by the last pass.

layout(local_size_x = 8, local_size_y = 8) in;

#include "scene.glsl"

layout(push_constant) uniform Pass
{
	int		step;		// 0: take the bright part out; 1: blur across; 2: blur down
	int		unused0, unused1, unused2;
} pass;

// How far over white a pixel counts as being for the glow, x being how far
// it is: all of it up to half of most, and from there less and less of what
// is left, never reaching most. No limit if most is not above 0.
float BloomExcess(float x, float most)
{
	const float knee = most * 0.5;
	if (most <= 0.0 || x <= knee)
		return x;
	return knee + (most - knee) * (1.0 - exp(-(x - knee) / (most - knee)));
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 size = fr.size.xy;
	const ivec2 half_size = max(size / 2, ivec2(1));
	if (pixel.x >= half_size.x || pixel.y >= half_size.y)
		return;

	if (pass.step == 0)
	{
		vec3 sum = vec3(0.0);
		for (int k = 0; k < 4; k++)
		{
			const ivec2 q = min(pixel * 2 + ivec2(k & 1, k >> 1), size - 1);
			const vec3 c = imageLoad(img_hdr, q).rgb;
			const float lum = Luminance(c);
			if (lum > 1.0)
				sum += c * (BloomExcess(lum - 1.0, fr.painted.y) / lum);
		}
		imageStore(img_bloom[0], pixel, vec4(sum * 0.25, 1.0));
		return;
	}

	// a box blur; three of them, across and down, come close to a gaussian
	const int radius = max(1, half_size.y / 48);
	const ivec2 along = pass.step == 1 ? ivec2(1, 0) : ivec2(0, 1);
	const int from = pass.step == 1 ? 0 : 1;
	vec3 sum = vec3(0.0);
	for (int i = -radius; i <= radius; i++)
		sum += imageLoad(img_bloom[from], clamp(pixel + along * i, ivec2(0), half_size - 1)).rgb;
	imageStore(img_bloom[1 - from], pixel, vec4(sum / float(2 * radius + 1), 1.0));
}
