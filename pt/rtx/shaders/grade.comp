#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Adds the glow to the picture and grades it for the screen, still at the
// size it was traced at. The last pass builds the full size picture from
// this.

layout(local_size_x = 8, local_size_y = 8) in;

#include "scene.glsl"

layout(push_constant) uniform Pass
{
	int		glow;		// there is a blurred glow to add
	int		unused0, unused1, unused2;
} pass;

vec3 ToneMap(vec3 c)
{
	const vec3 x = max(c, vec3(0.0));
	vec3 y;
	if (fr.output_i.x == 1)			// rolls off gently towards white at 4
		y = x * (1.0 + x * (1.0 / 16.0)) / (1.0 + x);
	else if (fr.output_i.x == 2)	// clipped, like the original
		y = x;
	else							// Narkowicz's fit to the ACES filmic curve
		y = (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14);
	y = clamp(y, 0.0, 1.0);

	const float saturation = fr.output_f.x, contrast = fr.output_f.y;
	if (saturation != 1.0 || contrast != 1.0)
	{
		const float lum = Luminance(y);
		y = max(vec3(lum) + (y - vec3(lum)) * saturation, vec3(0.0));
		if (contrast != 1.0)
			y = 0.18 * pow(y * (1.0 / 0.18), vec3(contrast));	// pivots on mid grey
		y = min(y, vec3(1.0));
	}
	return y;
}

// the half size glow, between its four nearest pixels
vec3 Glow(ivec2 q)
{
	const ivec2 half_size = max(fr.size.xy / 2, ivec2(1));
	const vec2 f = (vec2(q) + 0.5) * 0.5 - 0.5;
	const ivec2 p0 = clamp(ivec2(floor(f)), ivec2(0), half_size - 1);
	const ivec2 p1 = min(p0 + 1, half_size - 1);
	const vec2 a = clamp(f - vec2(p0), 0.0, 1.0);
	return mix(mix(imageLoad(img_bloom[0], p0).rgb, imageLoad(img_bloom[0], ivec2(p1.x, p0.y)).rgb, a.x),
		mix(imageLoad(img_bloom[0], ivec2(p0.x, p1.y)).rgb, imageLoad(img_bloom[0], p1).rgb, a.x), a.y);
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= fr.size.x || pixel.y >= fr.size.y)
		return;

	vec3 c = imageLoad(img_hdr, pixel).rgb;
	if (pass.glow != 0)
		c += Glow(pixel) * fr.output_f.z;
	imageStore(img_graded, pixel, vec4(fr.settings2.w != 0 ? clamp(c, 0.0, 1.0) : ToneMap(c), 1.0));
}
